# =============================================================================
# GoMirai Microservices - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git! Only commit this env.example
# =============================================================================

# -----------------------------------------------------------------------------
# JWT Secret - CRITICAL SECURITY SETTING
# -----------------------------------------------------------------------------
# This secret is used to sign and verify JWT tokens across all services
# MUST be the same across ApiGateway, AuthService, and UserService
# 
# RECOMMENDED: Use a strong, random BASE64-encoded key (at least 256 bits)
# Generate with: openssl rand -base64 32
# 
# Format: BASE64:<your-base64-encoded-secret>
# Example: BASE64:YourVeryLongRandomBase64EncodedSecretKeyHere==
# 
# OR use a plain text secret (minimum 32 characters):
# Example: your-very-long-secret-key-at-least-32-characters-long
# -----------------------------------------------------------------------------
JWT_SECRET=BASE64:YourVeryLongRandomBase64EncodedSecretKeyHere==

# -----------------------------------------------------------------------------
# JWT Token Settings
# -----------------------------------------------------------------------------
# Token expiration time in milliseconds
# Default: 3600000 (1 hour)
# SECURITY_JWT_TTL_MS=3600000

# -----------------------------------------------------------------------------
# MongoDB Connection Strings
# -----------------------------------------------------------------------------
# Format: mongodb://username:password@host:port/database?authSource=admin
# For local development: mongodb://localhost:27017/dbname
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/dbname

# AuthService MongoDB
AUTH_MONGODB_URI=mongodb://localhost:27017/auth_db

# UserService MongoDB
USER_MONGODB_URI=mongodb://localhost:27017/user_db

# DriverService MongoDB
DRIVER_MONGODB_URI=mongodb://localhost:27017/driver_db

# PricingService MongoDB
PRICING_MONGODB_URI=mongodb://localhost:27017/pricing_db

# BookingService MongoDB
BOOKING_MONGODB_URI=mongodb://localhost:27017/booking_db

# -----------------------------------------------------------------------------
# Mapbox API Configuration (For Map Service)
# -----------------------------------------------------------------------------
# Get your access token from: https://account.mapbox.com/access-tokens/
# Free tier: 100,000 requests/month
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6ImN...

# -----------------------------------------------------------------------------
# Redis Configuration (For Tracking Service)
# -----------------------------------------------------------------------------
# Option 1: Redis URI (Recommended for cloud Redis)
# Format: redis://username:password@host:port
#         rediss://username:password@host:port (SSL/TLS)
# 
# Examples:
# - Redis Cloud: redis://default:your-password@redis-12345.c1.us-east-1-1.ec2.cloud.redislabs.com:12345
# - Upstash: rediss://default:your-password@redis-12345.upstash.io:6379
# - AWS ElastiCache: redis://your-cluster.cache.amazonaws.com:6379
# - Azure Cache: redis://your-cache.redis.cache.windows.net:6380?ssl=true
# 
# ✅ Redis Cloud Connection String (Redis Labs)
SPRING_REDIS_URL=redis://default:6BmJiRcInODDwecMLRgfhdO8KMlZoJ4u@redis-12161.c232.us-east-1-2.ec2.cloud.redislabs.com:12161

# Option 2: Separate host/port (for local Redis or custom config)
# SPRING_REDIS_HOST=localhost
# SPRING_REDIS_PORT=6379
# SPRING_REDIS_PASSWORD=
# SPRING_REDIS_USERNAME=
# SPRING_REDIS_SSL_ENABLED=false

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
# Kafka bootstrap servers
# For local Docker: kafka:29092
# For local host: localhost:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# -----------------------------------------------------------------------------
# Consul Configuration (Service Discovery)
# -----------------------------------------------------------------------------
# Consul host
# For Docker: consul
# For local: localhost
SPRING_CLOUD_CONSUL_HOST=consul
SPRING_CLOUD_CONSUL_PORT=8500

# -----------------------------------------------------------------------------
# Application Ports (for reference - configured in docker-compose.yml)
# -----------------------------------------------------------------------------
# API Gateway:   8080
# Auth Service:  8081 (should not be exposed publicly)
# User Service:  8082 (should not be exposed publicly)
# Consul:        8500
# Kafka:         9092
# Zookeeper:     2181

# -----------------------------------------------------------------------------
# CORS Settings (configured in 
)
# -----------------------------------------------------------------------------
# NOTE: CORS is now configured per-service in application.properties
# This provides better security isolation:
# 
# ApiGateway: Only allows Angular frontend (localhost:4200)
#   - This is the ONLY entry point for external clients
# 
# AuthService: Only allows ApiGateway (localhost:8080)
#   - Backend service, NOT accessible directly from browsers
# 
# UserService: Only allows ApiGateway (localhost:8080)
#   - Backend service, NOT accessible directly from browsers
# 
# For PRODUCTION, update application.properties in each service:
# - ApiGateway: cors.allowed.origins=https://yourdomain.com
# - AuthService: cors.allowed.origins=http://api-gateway:8080
# - UserService: cors.allowed.origins=http://api-gateway:8080

# -----------------------------------------------------------------------------
# Security Settings (Optional)
# -----------------------------------------------------------------------------
# Maximum request size (to prevent large payload attacks)
# MAX_REQUEST_SIZE=10MB

# Rate limiting (requests per minute per IP)
# RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Logging Levels (Optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL_ROOT=INFO
# LOG_LEVEL_SECURITY=DEBUG
# LOG_LEVEL_KAFKA=INFO

# =============================================================================
# IMPORTANT SECURITY NOTES:
# =============================================================================
# 1. NEVER use default/example values in production!
# 2. Generate a NEW random JWT_SECRET for each environment
# 3. Use strong passwords for MongoDB
# 4. Restrict MongoDB network access
# 5. Enable SSL/TLS for production databases
# 6. Use secrets management tools (AWS Secrets Manager, HashiCorp Vault) in production
# 7. Rotate JWT_SECRET periodically
# 8. Monitor and log all authentication attempts
# =============================================================================

