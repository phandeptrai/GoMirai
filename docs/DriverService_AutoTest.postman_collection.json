						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/drivers/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"drivers",
								"me"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Admin Actions (Approval)",
			"item": [
				{
					"name": "Login as Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login Admin thành công (200)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"// Kiểm tra accessToken (hoặc token tùy response của bạn)",
									"if (jsonData.accessToken) {",
									"    pm.environment.set(\"admin_token\", jsonData.accessToken);",
									"    console.log(\"Đã lưu Admin Token\");",
									"} else if (jsonData.token) {",
									"    pm.environment.set(\"admin_token\", jsonData.token);",
									"    console.log(\"Đã lưu Admin Token (dạng token)\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"01111111111\", \n  \"password\": \"TestPass123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập Admin để lấy token duyệt hồ sơ."
					},
					"response": []
				},
				{
					"name": "Approve Driver",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Duyệt thành công (200)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"pm.test(\"Trạng thái chuyển sang ACTIVE\", function () {",
									"    pm.expect(jsonData.accountStatus).to.eql(\"ACTIVE\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/drivers/{{driver_id}}/approve",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"drivers",
								"{{driver_id}}",
								"approve"
							]
						}
					},
					"response": []
				}
			]
		},
