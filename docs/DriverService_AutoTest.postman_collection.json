{
	"info": {
		"_postman_id": "driver-flow-v2",
		"name": "GoMirai Driver Flow (Auto Admin)",
		"description": "Chạy sau AuthAndUser. Đã tích hợp sẵn tài khoản Admin 01111111111.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. User Actions (Candidate)",
			"item": [
				{
					"name": "Apply to be Driver",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Đăng ký thành công (201)\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.driverId) {",
									"    pm.environment.set(\"driver_id\", jsonData.driverId);",
									"    console.log(\"Đã lưu Driver ID: \" + jsonData.driverId);",
									"}",
									"",
									"pm.test(\"Trạng thái ban đầu phải là PENDING\", function () {",
									"    pm.expect(jsonData.accountStatus).to.eql(\"PENDING_VERIFICATION\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"licenseNumber\": \"79C1-123456\",\n  \"vehicleBrand\": \"Honda\",\n  \"vehicleModel\": \"City\",\n  \"plateNumber\": \"51A-99999\",\n  \"color\": \"White\",\n  \"vehicleType\": \"CAR_4\",\n  \"registrationDate\": \"2023-01-01\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/drivers/apply",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"drivers",
								"apply"
							]
						},
						"description": "Sử dụng token của User thường (từ collection trước) để nộp hồ sơ."
					},
					"response": []
				},
				{
					"name": "Get My Driver Profile",
					"event": [
						{
							"listen": "test",
							"script": {
