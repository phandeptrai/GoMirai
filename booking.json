	"item": [
		{
			"name": "1. Create Booking (CUSTOMER)",
			"item": [
				{
					"name": "Create Booking - Success (WALLET)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response has booking data\", function () {",
									"    pm.expect(jsonData.data).to.have.property('bookingId');",
									"    pm.expect(jsonData.data.status).to.eql('PENDING');",
									"});",
									"",
									"if (jsonData.data && jsonData.data.bookingId) {",
									"    pm.environment.set(\"booking_id\", jsonData.data.bookingId);",
									"    pm.environment.set(\"customer_id\", jsonData.data.customerId);",
									"    console.log(\"Saved booking_id: \" + jsonData.data.bookingId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customer_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
