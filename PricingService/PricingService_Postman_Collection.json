		{
			"name": "2. Calculate Final Pricing",
			"item": [
				{
					"name": "Calculate Final - Success",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bookingServiceToken}}",
								"description": "JWT token với ROLE_BOOKING_SERVICE"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rideId\": \"ride-12345\",\n  \"vehicleType\": \"MOTORBIKE\",\n  \"actualDistanceKm\": 5.8,\n  \"actualDurationMinute\": 22,\n  \"region\": \"HCM\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/pricing/calculate-final?estimatedDistanceKm=5.5&estimatedDurationMinute=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "pricing", "calculate-final"],
							"query": [
								{
									"key": "estimatedDistanceKm",
									"value": "5.5"
								},
								{
									"key": "estimatedDurationMinute",
									"value": "20"
