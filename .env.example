# GoMirai Microservices - Environment Configuration Template
# Copy this file to .env and fill in the actual values

# ============================================
# MongoDB Atlas Configuration
# ============================================
# Get your MongoDB Atlas connection string from:
# https://cloud.mongodb.com → Clusters → Connect → Connect your application
MONGODB_AUTH_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<appName>
MONGODB_USER_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<appName>

# ============================================
# Consul Configuration
# ============================================
# For Docker: use service name
# For local: use localhost
CONSUL_HOST=consul
CONSUL_PORT=8500

# ============================================
# Kafka Configuration
# ============================================
# For Docker: use kafka:29092 (internal listener)
# For local: use localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ============================================
# Service Ports (Optional - can override)
# ============================================
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
