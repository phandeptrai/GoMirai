  "item": [
    {
      "name": "1. Validation Errors (Input Data)",
      "item": [
        {
          "name": "Apply - Missing Required Fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Hệ thống bắt lỗi thiếu trường (400)\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Chi tiết lỗi trả về đúng\", function () {",
                  "    // Kiểm tra xem có field 'errors' không (theo mục 4.1 tài liệu)",
                  "    pm.expect(jsonData).to.have.property(\"errors\");",
                  "    ",
                  "    // Kiểm tra cụ thể lỗi thiếu licenseNumber",
                  "    // (Tùy field name trong code bạn, ví dụ 'licenseNumber' hoặc 'license_number')",
                  "    pm.expect(jsonData.errors).to.have.property(\"licenseNumber\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleBrand\": \"Toyota\" \n  // Cố tình thiếu licenseNumber, plateNumber...\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/drivers/apply",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "drivers",
                "apply"
              ]
            },
            "description": "Test trường hợp gửi thiếu thông tin bắt buộc."
          },
          "response": []
        },
