    {
      "name": "2. Security Errors (Authorization)",
      "item": [
        {
          "name": "User tries to Approve Driver (Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Chặn User thường gọi API Admin (500)\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Thông báo lỗi Forbidden\", function () {",
                  "    // Check theo tài liệu mục 4.3",
                  "    pm.expect(jsonData.error).to.eql(\"Forbidden\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/drivers/{{driver_id}}/approve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driver_id}}",
                "approve"
              ]
            },
            "description": "QUAN TRỌNG: Request này dùng {{auth_token}} (User thường) thay vì Admin token. Phải bị chặn."
          },
          "response": []
        },
