    {
      "name": "2. User Module",
      "item": [
        {
          "name": "2.1 Profile Management",
          "item": [
            {
              "name": "Get Profile",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Lấy Profile thành công\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "var jsonData = pm.response.json();",
                      "pm.test(\"SĐT khớp\", function () {",
                      "    pm.expect(jsonData.phone).to.eql(pm.environment.get(\"random_phone\"));",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{auth_token}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/users/{{user_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "{{user_id}}"
                  ]
                }
              },
              "response": []
            },
