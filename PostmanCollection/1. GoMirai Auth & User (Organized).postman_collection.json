    {
      "name": "1. Auth Module",
      "item": [
        {
          "name": "1.1 Registration",
          "item": [
            {
              "name": "Register User (Success)",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "// Sinh số ngẫu nhiên",
                      "const randomPhone = \"0\" + Math.floor(Math.random() * 1000000000).toString().padStart(9, '0');",
                      "// Lưu vào biến môi trường",
                      "pm.environment.set(\"random_phone\", randomPhone);",
                      "console.log(\"SĐT test: \" + randomPhone);"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// 1. Kiểm tra API trả về thành công (201 hoặc 200)",
                      "pm.test(\"Status code is success\", function () {",
                      "    pm.response.to.be.success; ",
                      "});",
                      "",
                      "var jsonData = pm.response.json();",
                      "console.log(\"Dữ liệu nhận được:\", jsonData);",
                      "",
                      "// 2. Lưu accessToken và UserId",
                      "if (jsonData.accessToken) {",
                      "    pm.environment.set(\"auth_token\", jsonData.accessToken);",
                      "    pm.environment.set(\"user_id\", jsonData.userId);",
                      "    console.log(\"✅ Đã lưu accessToken thành công!\");",
                      "} else {",
                      "    console.log(\"❌ LỖI: Không tìm thấy 'accessToken' trong phản hồi!\");",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phoneNumber\": \"{{random_phone}}\",\n  \"password\": \"TestPass123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/register",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "register"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Register - Duplicate User",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Chặn trùng SĐT (409 hoặc 400)\", function () {",
                      "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                      "});",
                      "",
                      "var jsonData = pm.response.json();",
                      "pm.test(\"Thông báo lỗi đúng\", function () {",
                      "    var msg = JSON.stringify(jsonData).toLowerCase();",
                      "    pm.expect(msg).to.include(\"tồn tại\");",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phoneNumber\": \"{{random_phone}}\",\n  \"password\": \"TestPass123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/register",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
