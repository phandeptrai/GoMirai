                  "pm.test(\"Không tìm thấy xe 7 chỗ (200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Danh sách phải rỗng\", function () {",
                  "    pm.expect(jsonData.length).to.eql(0);",
                  "});"
                ],
