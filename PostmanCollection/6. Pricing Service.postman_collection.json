    {
      "name": "1. Admin & Rule Management (Roles: ADMIN)",
      "item": [
        {
          "name": "1.1 ✅ Create Pricing Rule (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Rule ID is generated\", function () {",
                  "    pm.expect(jsonData.ruleId).to.be.a('string').and.to.have.lengthOf(36);",
                  "});",
                  "// Lưu Rule ID để sử dụng cho bước Update",
                  "pm.environment.set(\"pricing_rule_id\", jsonData.ruleId);",
                  "pm.environment.set(\"base_fare_motor\", jsonData.baseFare); // Lưu giá cơ bản để ước tính"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruleId\": null,\n  \"vehicleType\": \"MOTORBIKE\",\n  \"baseFare\": 10000,\n  \"perKmRate\": 5000,\n  \"perMinuteRate\": 1000,\n  \"surgeMultiplier\": 1.0,\n  \"region\": \"HCM\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/pricing/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pricing",
                "rules"
              ]
            },
            "description": "Test Case 7: Tạo rule thành công (Cần ROLE_ADMIN)."
          },
          "response": []
