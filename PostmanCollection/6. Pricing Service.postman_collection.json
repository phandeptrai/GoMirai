    {
      "name": "3. Calculate Final Pricing (Roles: BOOKING_SERVICE)",
      "item": [
        {
          "name": "3.1 ✅ Calculate Final - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tính giá cuối cùng thành công (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Giá cuối cùng > Giá ước tính (Do surge)\", function () {",
                  "    pm.expect(jsonData.estimatedFare).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
