    {
      "name": "2. Estimate Pricing (Public API)",
      "item": [
        {
          "name": "2.1 ✅ Estimate Pricing - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Test Case 1: Ước tính thành công (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Giá ước tính > 0 và có Rule ID\", function () {",
                  "    pm.expect(jsonData.estimatedFare).to.be.above(0);",
                  "    pm.expect(jsonData.appliedRuleId).to.be.a('string');",
                  "});",
                  "// Tính tay để kiểm tra sơ bộ (12000 + 5.5*5500 + 20*1200) * 1.2 = ~ 77.000",
                  "// pm.expect(jsonData.estimatedFare).to.be.above(70000); // Thử so sánh với tính tay"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleType\": \"MOTORBIKE\",\n  \"distanceKm\": 5.5,\n  \"durationMinute\": 20,\n  \"region\": \"HCM\"\n}",
              "options": {
