                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Có các trường địa chỉ chi tiết\", function () {",
                  "    pm.expect(jsonData.address).to.not.be.empty;",
                  "    pm.expect(jsonData).to.have.property('city');",
