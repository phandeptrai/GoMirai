  "item": [
    {
      "name": "1. Route & Matrix APIs",
      "item": [
        {
          "name": "1.1 ✅ Directions (Route Between Two Points)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tính lộ trình thành công (200 OK)\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Kiểm tra cấu trúc RouteResponse\", function () {",
                  "    pm.expect(jsonData).to.have.property('distance');",
                  "    pm.expect(jsonData.steps).to.be.an('array').and.to.have.length.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"latitude\": 10.7720,\n    \"longitude\": 106.6983\n  },\n  \"destination\": {\n    \"latitude\": 10.7797,\n    \"longitude\": 106.6991\n  },\n  \"profile\": \"driving\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/map/directions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "map",
                "directions"
              ]
            },
            "description": "Tính khoảng cách/thời gian giữa 2 điểm (Direction)."
          },
          "response": []
        },
        {
          "name": "1.2 ✅ Directions - Missing Origin (Validation Fix)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Chặn lỗi thiếu Origin (400)\", function () {\r",
                  "    pm.response.to.have.status(400);\r",
                  "});",
                  "var jsonData = pm.response.json();",
                  "// Sửa Assertion: Kiểm tra lỗi chi tiết trong object 'errors' (vì lỗi cũ là Fail 2)",
                  "pm.test(\"Thông báo lỗi chi tiết Origin is required\", function () {",
                  "    pm.expect(jsonData).to.have.property('errors');",
                  "    pm.expect(jsonData.errors.origin).to.include(\"Origin is required\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": {\n    \"latitude\": 10.7797,\n    \"longitude\": 106.6991\n  },\n  \"profile\": \"driving\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/map/directions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "map",
                "directions"
              ]
            }
          },
          "response": []
        },
