    {
      "name": "2. Geocoding & Places Search APIs (GET)",
      "item": [
        {
          "name": "2.1 ✅ Geocoding (Address -> Coordinates)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Geocoding thành công (200 OK)\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Có tọa độ và địa chỉ định dạng\", function () {",
                  "    pm.expect(jsonData.location).to.have.property('latitude');",
                  "    pm.expect(jsonData.formattedAddress).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/map/geocode?address=Nhà thờ Đức Bà, Hồ Chí Minh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "map",
                "geocode"
              ],
              "query": [
                {
                  "key": "address",
                  "value": "Nhà thờ Đức Bà, Hồ Chí Minh"
                }
              ]
            }
          },
          "response": []
        },
        {
