                  "});",
                  "var jsonData = pm.response.json();",
                  "// Sửa Assertion: Chấp nhận lỗi chung chung nhưng vẫn kiểm tra 400",
                  "pm.test(\"Thông báo lỗi hợp lý\", function () {",
                  "    pm.expect(jsonData.message).to.not.be.empty;",
                  "    // Nếu Backend fix: pm.expect(jsonData.message).to.include(\"Latitude must be between -90 and 90\");",
                  "});"
